# Aegis — copy to .env (never commit secrets)

ENV=local
DEPLOYMENT_ENVIRONMENT=production
SERVICE_VERSION=1.0.0
APP_NAME=aegis
PRODUCT_TITLE=Aegis

OTEL_SERVICE_NAME=aegis
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=YOUR_INGESTION_KEY
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=10000

SIGNOZ_URL=https://your-instance.us2.signoz.cloud
SIGNOZ_API_KEY=YOUR_SIGNOZ_API_KEY
SIGNOZ_MCP_URL=https://mcp.us2.signoz.cloud/mcp
SIGNOZ_USE_MCP=true

# Reasoner: auto | offline | (provider keys optional)
LLM_BACKEND=auto
DEFAULT_MODEL=
# Optional provider keys (not shown in UI by brand name)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
